{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "museai-social-static-worker",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": false
  }
}
